+test("a failed reopening releases the browser slot and temporary cache, retaining saved storage", {
+  timeout: 30000,
+}, async (t) => {
+  const fixture = await createBrowserFixture();
+  const directory = await mkdtemp(join(tmpdir(), "browser-reopen-cleanup-"));
+  const first = randomUUID(),
+    second = randomUUID();
+  const browser = await createBrowserManager(
+    { dataDir: directory, maxSessions: 1 },
+    fixture.createProxy,
+  );
+  t.after(async () => {
+    await browser.close();
+    await fixture.close();
+    await rm(directory, { recursive: true, force: true });
+    for (const id of [first, second])
+      await rm(join("/tmp", `openmuse-downloads-${id}`), { recursive: true, force: true });
+  });
+  await browser.create(first, `${fixtureOrigin}/seed`);
+  await assert.rejects(browser.create(first, `${fixtureOrigin}/redirect-private`), {
+    code: "NAVIGATION_FAILED",
+  });
+  assert.equal(browser.list().filter((session) => session.status === "active").length, 0);
+  await assert.rejects(stat(join("/tmp", `openmuse-downloads-${first}`)), { code: "ENOENT" });
+  await browser.create(second, `${fixtureOrigin}/page`);
+  await browser.closeSession(second);
+  await assert.rejects(stat(join("/tmp", `openmuse-downloads-${second}`)), { code: "ENOENT" });
+  await browser.create(first, `${fixtureOrigin}/state`);
+  assert.equal((await browser.read(first)).text, "retained");
+  if (process.platform !== "win32") {
+    const profile = `--user-data-dir=${join(directory, first, "profile")}`;
+    const processLine = execFileSync("ps", ["-axo", "pid=,command="], { encoding: "utf8" })
+      .split("\n")
+      .find((line) => line.includes(profile) && !line.includes("--type="));
+    assert.ok(processLine, "find only this fixture's Chromium process");
+    const pid = Number(/^\s*(\d+)/.exec(processLine)?.[1]);
+    assert.ok(pid > 1 && pid !== process.pid);
+    process.kill(pid, "SIGKILL");
+    for (let attempt = 0; attempt < 100; attempt++) {
+      if (browser.list().find((session) => session.id === first)?.status === "error") break;
+      await new Promise((resolve) => setTimeout(resolve, 20));
+    }
+    assert.equal(browser.list().find((session) => session.id === first)?.status, "error");
+    await assert.rejects(stat(join("/tmp", `openmuse-downloads-${first}`)), { code: "ENOENT" });
+    await browser.create(second, `${fixtureOrigin}/page`);
+  }
+});
