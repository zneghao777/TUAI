{
  "name": "@tianzhiai/workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=26.8.1 <27" },
  "scripts": {
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json",
    "build": "pnpm run typecheck && node scripts/build.mjs",
    "start": "node --expose-internals apps/cli/lib/index.js",
    "audit:upstream": "node scripts/audit-upstream.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
