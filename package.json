{
  "name": "@tianzhiai/workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "scripts": {
    "typecheck": "pnpm run generate:protocol && tsc -b native/system/packages/entry tsconfig.host.json tsconfig.client.json",
    "build": "pnpm run typecheck && node scripts/build.mjs",
    "start": "node --expose-internals apps/cli/lib/index.js",
    "audit:upstream": "node scripts/audit-upstream.mjs",
    "test:loader": "node --expose-internals --test tests/loader.test.mjs",
    "test:upstream": "vitest run --config vitest.p0.config.ts",
    "test:boot": "node --expose-internals --test tests/boot.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-docs.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "test": "node --expose-internals --test tests/*.test.mjs && pnpm run test:upstream && pnpm run test:p1 && pnpm run test:p2",
    "check": "pnpm run format:check && pnpm run build && pnpm run build:web && pnpm run check:docs && pnpm run check:workspace && pnpm run check:licenses && pnpm test",
    "verify:clean": "node scripts/verify-clean.mjs",
    "test:p1": "vitest run --config vitest.config.ts && node --expose-internals --test-timeout=15000 --test tests/p1/*.test.mjs",
    "verify:replay": "node scripts/verify-replay.mjs",
    "generate:protocol": "tsx scripts/generate-protocol.ts",
    "start:web": "node --expose-internals apps/cli/lib/web.js",
    "build:web": "pnpm --filter @tianzhiai/web build",
    "dev:web": "pnpm --filter @tianzhiai/web dev",
    "test:p2": "vitest run --config vitest.p2.config.ts && node --expose-internals --test --test-timeout=30000 tests/p2/*.test.mjs",
    "test:ui": "node --expose-internals node_modules/@playwright/test/cli.js test --config playwright.config.ts",
    "demo:p2": "node --expose-internals tests/p2/demo.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "prettier": "3.8.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "execa": "10.0.1",
    "fast-check": "4.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.1",
    "jsdom": "29.1.1"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@deepseek-ai/cordis-plugin-include": "workspace:*"
  }
}
